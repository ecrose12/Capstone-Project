{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "mywordsmatter",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "mywordsmatter.app",
			"custom_domain": true
		}
	],
	"vars": {
		"ADMIN_EMAILS": "elizabethgcrose@gmail.com,laura.m.sohl@gmail.com",
		"EMAIL_FROM": "notifications@mywordsmatter.app",
		"NEXT_PUBLIC_APP_URL": "https://mywordsmatter.app",
		"NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_0WX15li9J5lkOdm79jEzvA_cyLRzL1m",
		"NEXT_PUBLIC_SUPABASE_URL": "https://pqaqpoucwtcvlhjqwjzc.supabase.co",
		"SUPPORT_TEAM_EMAILS": "support@mywordsmatter.app"
	}
}
